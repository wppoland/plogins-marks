includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - plogins-sale-stock-badges.php
        - uninstall.php
        - src
        - config
    excludePaths:
        # Elementor is an optional integration and its classes are not
        # installed for analysis (no stub package available), so every widget
        # here reads as an unknown base class. The runtime guard lives in
        # ElementorWidgets, which only loads these files once Elementor has
        # booted.
        - src/Elementor/
        - src/Service/ElementorWidgets.php
        - vendor/
    bootstrapFiles:
        - tests/phpstan/constants.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
