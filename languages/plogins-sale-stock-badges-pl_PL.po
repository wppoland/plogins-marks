#. Plugin Name of the plugin
#: plogins-sale-stock-badges.php
msgid "Sale & Stock Badges for WooCommerce"
msgstr "Oznaczenia promocji i stanu magazynowego dla WooCommerce"

#. Plugin URI of the plugin
#: plogins-sale-stock-badges.php
msgid "https://plogins.com/plogins-sale-stock-badges/"
msgstr "https://plogins.com/plogins-sale-stock-badges/"

#. Description of the plugin
#: plogins-sale-stock-badges.php
msgid ""
"Automatic and manual product badges for WooCommerce (sale, new, low-stock, "
"bestseller): CSS-only, no layout shift."
msgstr "Automatyczne i ręczne oznaczenia produktów dla WooCommerce (promocja, nowość, niski stan, bestseller): tylko CSS, bez przesunięć układu."

#. Author of the plugin
#: plogins-sale-stock-badges.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-sale-stock-badges.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-sale-stock-badges.php:48
msgid "Sale & Stock Badges requires WooCommerce to be active."
msgstr "Oznaczenia promocji i stanu magazynowego wymagają aktywnego WooCommerce."

